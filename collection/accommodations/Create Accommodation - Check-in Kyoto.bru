meta {
  name: Create Accommodation - Check-in Kyoto
  type: http
  seq: 3
}

post {
  url: {{base_url}}/accommodations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "trip_day_id": 5,
    "accommodation_type": "check_in",
