meta {
  name: Get My Profile
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/users/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  # Get My Profile

  Retrieves the current authenticated user's profile information.

  ## Authentication Required
  - Yes (Bearer token)

  ## Response
  Returns UserResponse with all user profile data including:
  - User ID
  - Email (verified)
  - Username (optional)
  - Profile info (first_name, last_name, bio, profile_photo_url)
  - Preferences (currency, date_format, timezone, language)
  - Account status (is_active)
  - Timestamps (created_at, last_login_at)
}
